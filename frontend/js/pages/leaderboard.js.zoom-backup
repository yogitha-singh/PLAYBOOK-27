import * as api from '../api.js';
import { html, raw, n0, n1, frac, pct1, signed1 } from '../util.js';
import { card, table, tierBadge, confBadge, playerCell, callout, evidenceNote } from '../components.js';
import { forest } from '../charts.js';

export const meta = { path: 'leaderboard', title: 'Reliability Leaderboard', nav: 'Reliability Leaderboard' };
const SORTS = { reliability: ['PRI', 'desc', 'Reliability score (PRI)'], pressure: ['level100', 'desc', 'Pressure performance'], consistency: ['consistency_pct', 'desc', 'Consistency'], sample: ['pressure_deliveries', 'desc', 'Sample size'], confidence: ['sample_confidence', 'asc', 'Confidence'] };
export async function load(ctx) {
  const role = ctx.query.role === 'bowl' ? 'bowl' : 'bat', by = SORTS[ctx.query.by] ? ctx.query.by : 'reliability', [sk, so] = SORTS[by];
  const res = await api.get(role === 'bat' ? '/batters/rankings' : '/bowlers/rankings', { page_size: 100, sort_by: sk, order: so });
  return { role, by, res };
}
export function view({ role, by, res }) {
  const bat = role === 'bat', rows = res.items;
  return html`<p class="lead">Separate batting and bowling rankings. The order below changes with the sort; the <strong>tier</strong> and interval always describe how much to trust each position.</p>
  <div class="controls"><span role="group" aria-label="Role"><a class="btn${bat ? ' primary' : ''}" href="#/leaderboard?role=bat&by=${by}">Batters</a> <a class="btn${bat ? '' : ' primary'}" href="#/leaderboard?role=bowl&by=${by}">Bowlers</a></span>
  <label>Sort by <select id="lb-by">${Object.entries(SORTS).map(([k, v]) => html`<option value="${k}"${k === by ? raw(' selected') : ''}>${v[2]}</option>`)}</select></label>
  <a class="btn" href="${api.url(`/exports/rankings/${role}.csv`)}" download>Export CSV</a></div>
  ${card(`Top 20 by ${SORTS[by][2].toLowerCase()}`, raw(forest(rows.slice(0, 20).map((r, i) => ({ label: `${i + 1}. ${r.player}`, value: r.PRI, lo: r.PRI_lo, hi: r.PRI_hi })), { label: 'PRI with 90% intervals for the top 20 of the chosen sort', rowH: 26 })), { sub: 'Dots = PRI, bars = 90% bootstrap interval. The PRI axis is shown whatever the sort.' })}
  ${card('Full table', table({ caption: 'Reliability leaderboard', rows, columns: [{ label: '#', render: (r) => rows.indexOf(r) + 1 }, { label: 'Player', cls: 'player', render: playerCell }, { label: 'Tier', render: (r) => tierBadge(r.tier) }, { label: 'PRI', num: true, render: (r) => n1(r.PRI) }, { label: 'Primary rank (range)', num: true, render: (r) => html`${r.rank} <span class="muted small">(${r.rank_lo}â€“${r.rank_hi})</span>` },
    { label: 'Value/100 pressure', num: true, render: (r) => signed1(r.level100) }, { label: 'Consistency', num: true, render: (r) => pct1(r.consistency_pct) }, { label: 'Pressure n', num: true, render: (r) => n0(r.pressure_deliveries) }, { label: 'Confidence', render: (r) => confBadge(r.sample_confidence) }, { label: 'P(top 10)', num: true, render: (r) => frac(r.p_top10) }, { label: 'Top 10 in alt. configs', num: true, render: (r) => frac(r.share_top10), title: 'Share of 255 alternative configurations (pressure definition, wicket cost, weights, minimum sample) in which the player is top 10' }] }))}
  ${card('How the score is built', html`<ol class="plain"><li><strong>Pressure</strong> = top 20% of the Leverage Index (expected win-probability swing of the next ball) within each innings.</li><li><strong>Value</strong> = outcome minus what an average player achieves in the same situation (cross-fitted models).</li><li><strong>Shrinkage</strong> (empirical Bayes) pulls small samples toward average; each component is scaled by its estimated true spread.</li><li><strong>PRI</strong> = 50 + 10 Ã— mean of level, delta and consistency z-scores. Higher is better. The delta (vs own baseline) had no detectable signal, so it carries zero weight.</li><li><strong>Tiers</strong>: A = robust contender; B = plausible but assumption-sensitive; C = ranked pool.</li></ol>`, { sub: 'Full formulas and validation: Methodology.' })}${evidenceNote}`;
}
export function mount(root, data, ctx) { root.querySelector('#lb-by')?.addEventListener('change', (e) => ctx.navigate({ role: data.role, by: e.target.value })); root.addEventListener('click', async (e) => { const p = e.target.closest('[data-player]'); if (p) ctx.openPlayer(p.dataset.player, data.role); }); }


